# Application. Docker Compose overrides APP_DB_HOST/APP_DB_PORT inside containers.
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ROOT_PATH=
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true
APP_HTTP_WORKERS=1
APP_HTTP_TRUSTED_PROXY_IPS=
APP_HTTP_KEEP_ALIVE_SEC=5
APP_SHUTDOWN_TIMEOUT_SEC=15

# HTTP metrics. Histogram bounds are a JSON array in seconds.
APP_METRICS_ENABLED=true
APP_METRICS_HTTP_BUCKETS_SEC=[0.01,0.05,0.1,0.25,0.5,1,2.5,5,10,30,60]

# PostgreSQL. These credentials are only local demonstration defaults.
APP_DB_HOST=localhost
APP_DB_PORT=55432
APP_DB_USER=orbits
APP_DB_PASSWORD=orbits
APP_DB_NAME=orbits
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=0
APP_DB_POOL_TIMEOUT_SEC=5
APP_DB_CONNECT_TIMEOUT_SEC=5
APP_DB_STATEMENT_TIMEOUT_SEC=5
APP_DB_HEALTHCHECK_TIMEOUT_SEC=2

# Authentication. Fixed key for this demonstration; override through the environment if needed.
APP_AUTH_TOKEN_SECRET=local-demonstration-signing-secret-key
APP_AUTH_TOKEN_TTL_SEC=900
APP_AUTH_TOKEN_ISSUER=orbit-coordinate-service
APP_AUTH_TOKEN_AUDIENCE=orbit-api
APP_AUTH_PASSWORD_WORKERS=2
APP_AUTH_PASSWORD_MEMORY_KIB=65536
APP_AUTH_PASSWORD_TIME_COST=3
APP_AUTH_PASSWORD_PARALLELISM=2

# Redis is used only for shared request limits. Credentials are local demo defaults.
APP_REDIS_HOST=localhost
APP_REDIS_PORT=56379
APP_REDIS_DB=0
APP_REDIS_PASSWORD=orbits_redis
APP_REDIS_KEY_PREFIX=orbits
APP_REDIS_MAX_CONNECTIONS=20
APP_REDIS_CONNECT_TIMEOUT_SEC=2
APP_REDIS_SOCKET_TIMEOUT_SEC=2
APP_REDIS_HEALTHCHECK_TIMEOUT_SEC=2
APP_RATE_LIMIT_USER_REQUESTS=60
APP_RATE_LIMIT_USER_WINDOW_SEC=60
APP_RATE_LIMIT_LOGIN_REQUESTS=10
APP_RATE_LIMIT_LOGIN_WINDOW_SEC=60

# Calculation pool. Each HTTP process owns a separate pool.
APP_COMPUTE_WORKERS=2
APP_COMPUTE_MAX_POINTS=200000
APP_COMPUTE_CHUNK_POINTS=1024
APP_COMPUTE_NUMERIC_THREADS=1
APP_COMPUTE_TIMEOUT_SEC=60
APP_COMPUTE_START_TIMEOUT_SEC=30
APP_COMPUTE_HEALTHCHECK_TIMEOUT_SEC=2

# Manual benchmarks; reports stay outside Git in artifacts/.
APP_BENCH_MODE=http
APP_BENCH_BASE_URL=http://127.0.0.1:8000
APP_BENCH_INPUT=examples/request-omm.json
APP_BENCH_OUTPUT=artifacts/benchmark.json
APP_BENCH_REPETITIONS=5
APP_BENCH_CONCURRENCY=4
APP_BENCH_TIMEOUT_SEC=90
APP_BENCH_HEALTH_INTERVAL_SEC=0.05
APP_BENCH_USERNAME=testuser
APP_BENCH_PASSWORD=test-password

# Isolated test PostgreSQL. The database name must end in "_test".
APP_TEST_DB_HOST=localhost
APP_TEST_DB_PORT=55433
APP_TEST_DB_USER=orbits_test
APP_TEST_DB_PASSWORD=orbits_test
APP_TEST_DB_NAME=orbits_test

# Dedicated test Redis; tests use DB 15 and a unique test namespace.
APP_TEST_REDIS_HOST=localhost
APP_TEST_REDIS_PORT=56380
APP_TEST_REDIS_PASSWORD=orbits_redis_test

# Docker Compose / build settings, not Python runtime settings.
APP_DEPLOY_BIND_HOST=127.0.0.1
APP_DEPLOY_PYTHON_IMAGE=python:3.13.14-slim
APP_DEPLOY_POSTGRES_IMAGE=postgres:16-alpine
APP_DEPLOY_REDIS_IMAGE=redis:8-alpine
APP_DEPLOY_REDIS_MAX_MEMORY_BYTES=67108864
APP_DEPLOY_POETRY_VERSION=2.4.1
APP_DEPLOY_HEALTHCHECK_INTERVAL_SEC=5
APP_DEPLOY_HEALTHCHECK_TIMEOUT_SEC=3
APP_DEPLOY_HEALTHCHECK_START_PERIOD_SEC=10
APP_DEPLOY_HEALTHCHECK_RETRIES=10
