# Application. Docker Compose overrides APP_DB_HOST/APP_DB_PORT inside containers.
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ROOT_PATH=
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true
APP_HTTP_WORKERS=1
APP_HTTP_KEEP_ALIVE_SEC=5
APP_SHUTDOWN_TIMEOUT_SEC=15

# PostgreSQL. These credentials are only local demonstration defaults.
APP_DB_HOST=localhost
APP_DB_PORT=55432
APP_DB_USER=orbits
APP_DB_PASSWORD=orbits
APP_DB_NAME=orbits
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=0
APP_DB_POOL_TIMEOUT_SEC=5
APP_DB_CONNECT_TIMEOUT_SEC=5
APP_DB_STATEMENT_TIMEOUT_SEC=5
APP_DB_HEALTHCHECK_TIMEOUT_SEC=2

# Isolated test PostgreSQL. The database name must end in "_test".
APP_TEST_DB_HOST=localhost
APP_TEST_DB_PORT=55433
APP_TEST_DB_USER=orbits_test
APP_TEST_DB_PASSWORD=orbits_test
APP_TEST_DB_NAME=orbits_test

# Docker Compose / build settings, not Python runtime settings.
APP_DEPLOY_BIND_HOST=127.0.0.1
APP_DEPLOY_PYTHON_IMAGE=python:3.13.14-slim
APP_DEPLOY_POSTGRES_IMAGE=postgres:16-alpine
APP_DEPLOY_POETRY_VERSION=2.4.1
APP_DEPLOY_HEALTHCHECK_INTERVAL_SEC=5
APP_DEPLOY_HEALTHCHECK_TIMEOUT_SEC=3
APP_DEPLOY_HEALTHCHECK_START_PERIOD_SEC=10
APP_DEPLOY_HEALTHCHECK_RETRIES=10
